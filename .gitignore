.DS_Store
node_modules/
.vercel
*.log

# local secrets (API tokens for the sound library) — never committed
video/library/.env
.env

# generated by cut.mjs / fetch-sounds.mjs — rebuilt in the sandbox, placeholders here
video/*/assets/cut/
video/*/assets/sfx/*.m4a
video/*/data/cuts.json
video/library/freesound/
video/*/snap*/
# review stills and check output — regenerated by sandbox.sh; only the manifest is kept
video/*/review/*
!video/*/review/manifest.json

.DS_Store
node_modules/
.vercel
*.log

# local secrets (API tokens for the sound library) — never committed
video/library/.env
.env

# generated by cut.mjs / fetch-sounds.mjs — rebuilt in the sandbox, placeholders here
video/*/assets/cut/
video/*/assets/sfx/*.m4a
video/*/data/cuts.json
video/library/freesound/
video/*/snap*/
# review stills and check output — regenerated by sandbox.sh; only the manifest is kept
video/*/review/*
!video/*/review/manifest.json
motion/*/*/out/

# headless exports of the social creative (export-assets.mjs) — handed to Faisal, not committed
social-out/

# light-stage renders of the social creative (social/render.mjs) — handed to Faisal, not committed
social/out/
__pycache__/

# img2threejs keeps per-run state where it runs
**/.img2threejs/

# playwright-cli runtime: launch config written by the session-start hook, snapshots per session
.playwright/
.playwright-cli/
.claude/skills/playwright-skill/.playwright-skill/

# HyperFrames renders and the assets make-assets.sh rebuilds from brand/ and the supplied screens
video/*/renders/
video/*/assets/bands/
video/*/assets/mark.png
video/*/assets/wordmark-white.png
video/*/fonts/
video/*/vendor/
